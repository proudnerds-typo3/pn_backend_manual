        <body>
            <trans-unit id="link.newWindow" resname="link.newWindow">
                <source>opens in a new window</source>
                <target>opent in een nieuw venster</target>
            </trans-unit>
            <trans-unit id="manual.contents" resname="manual.contents">
                <source>Contents</source>
                <target>Inhoud</target>
            </trans-unit>
            <trans-unit id="manual.open" resname="manual.open">
                <source>Open the manual</source>
                <target>Handleiding openen</target>
            </trans-unit>
            <trans-unit id="manual.notFound.title" resname="manual.notFound.title">
                <source>Manual not available</source>
                <target>Handleiding niet beschikbaar</target>
            </trans-unit>
            <trans-unit id="manual.notFound.text" resname="manual.notFound.text">
                <source>This manual does not exist or you have no access to it. Access to a manual is granted through the dashboard widgets of your backend group.</source>
                <target>Deze handleiding bestaat niet of je hebt er geen toegang toe. Toegang krijg je via de dashboard-widgets van je backendgroep.</target>
            </trans-unit>
            <trans-unit id="manual.error.title" resname="manual.error.title">
                <source>Manual cannot be shown</source>
                <target>Handleiding kan niet getoond worden</target>
            </trans-unit>
            <trans-unit id="manual.error.text" resname="manual.error.text">
                <source>The manual contains an error and cannot be shown. The error has been logged; please contact an administrator.</source>
                <target>De handleiding bevat een fout en kan niet getoond worden. De fout is gelogd; neem contact op met een beheerder.</target>
            </trans-unit>
            <trans-unit id="manual.print" resname="manual.print">
                <source>Print or save as PDF</source>
                <target>Afdrukken of opslaan als PDF</target>
            </trans-unit>
            <trans-unit id="manual.feedback" resname="manual.feedback">
                <source>Give feedback</source>
                <target>Feedback geven</target>
            </trans-unit>
            <trans-unit id="manual.feedback.subject" resname="manual.feedback.subject">
                <source>Feedback: %s</source>
                <target>Feedback: %s</target>
            </trans-unit>
            <trans-unit id="manual.version" resname="manual.version">
                <source>Version %s</source>
                <target>Versie %s</target>
            </trans-unit>
            <trans-unit id="manual.updated" resname="manual.updated">
                <source>Updated %s</source>
                <target>Bijgewerkt op %s</target>
            </trans-unit>
            <trans-unit id="manual.search.label" resname="manual.search.label">
